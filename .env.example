# Local server settings only. Never add real keys to this example.
KEENABLE_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=career-scout-profile-3large-v1
PINECONE_INDEX_HOST=
# Use a Google AI Studio free-tier project; do not enable paid billing.
GEMINI_API_KEY=
# Analysis: gemini-3.1-flash-lite. Embeddings: gemini-embedding-001, 3072 dimensions.
# OpenAI keys and old endpoint overrides are ignored by Profile.
# Optional: pause embedding calls while keeping database/keyword retrieval.
# PROFILE_SEMANTIC_SEARCH=disabled
# Administration only; never deploy this token:
# SUPABASE_ACCESS_TOKEN=
# Public hosting only: enable anonymous, isolated visitor workspaces after the
# D1 session migration is deployed. Leave false for the private local workspace.
PUBLIC_DEMO_ENABLED=false
