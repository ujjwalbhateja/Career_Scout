# Local server settings only. Never add real keys to this example.
KEENABLE_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=career-scout-profile-3large-v1
PINECONE_INDEX_HOST=
# User-selected model. Configure credentials using OpenAI Developers key setup.
PROFILE_MODEL_NAME=gpt-6.1-sol
# OPENAI_API_KEY is supplied by secure server configuration.
# Embeddings are pinned to text-embedding-3-large with 3072 dimensions.
# Optional compatible endpoint overrides:
# PROFILE_MODEL_URL=https://api.openai.com/v1/chat/completions
# PROFILE_MODEL_API_KEY=
# Administration only; never deploy this token:
# SUPABASE_ACCESS_TOKEN=
